{
  "name": "gzw-hideout-tracker",
  "version": "1.3.2",
  "description": "GZW hideout tracker with automatic cloud saves and catalogue updates.",
  "author": "Nathan",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.gzw.hideout.tracker",
    "productName": "GZW Hideout Tracker",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json",
      "LICENSES.txt"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/app.ico",
      "artifactName": "GZW-Hideout-Tracker-${version}-Windows-x64.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": true
    }
  }
}
