{
  "name": "gzw-hideout-tracker",
  "version": "1.4.0",
  "description": "GZW hideout tracker with automatic cloud saves and catalogue updates.",
  "author": "Nathan",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.gzw.hideout.tracker",
    "productName": "GZW Hideout Tracker",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json",
      "LICENSES.txt"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/app.ico",
      "artifactName": "GZW-Hideout-Tracker-Windows-x64.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "Nl256",
      "repo": "gzw-hideout-tracker",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
